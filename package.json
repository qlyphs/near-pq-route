{
  "name": "qlyphs-pq87-near",
  "version": "1.0.0",
  "description": "Qlyphs post-quantum QTC route into NEAR Intents: keyless bridge contract, route cryptography, service Worker, page source and on-chain verifiers",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test tests/route-crypto.unit.mjs tests/quantus-evidence.unit.mjs tests/sdk.unit.mjs tests/demo.unit.mjs app/lib/pq-route/*.test.ts",
    "test:sandbox": "node tests/bridge.sandbox.mjs",
    "verify": "node scripts/verify-route.mjs && node scripts/verify-quantus.mjs",
    "measure": "node tests/measure.mjs",
    "test:relayer": "node --test relayer/",
    "relayer": "node relayer/server.mjs"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "near-workspaces": "^5.0.0"
  },
  "private": true,
  "dependencies": {
    "@fastnear/api": "^2.5.0",
    "@fastnear/ml-dsa-65": "^2.5.0",
    "@fastnear/utils": "^2.5.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@polkadot/api": "16.5.6",
    "@qlyphs/sdk": "^0.3.0",
    "near-api-js": "5.1.1"
  }
}
